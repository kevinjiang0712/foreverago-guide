{
  "name": "game-wiki-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src scripts tests",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "check:content": "tsx scripts/check-content.ts",
    "prepare:theme": "tsx scripts/prepare-theme.ts",
    "prepare:content": "tsx scripts/prepare-content.ts",
    "dev": "tsx scripts/dev.ts",
    "build": "npm run prepare:content && npm run prepare:theme && next build --webpack",
    "start": "next start",
    "verify:production": "tsx scripts/verify-production.ts",
    "verify:matrix": "tsx scripts/verify-matrix.ts",
    "create:site": "tsx scripts/create-site.ts",
    "assemble:site": "tsx scripts/assemble-site.ts",
    "verify:site": "tsx scripts/verify-site.ts",
    "verify:reuse": "tsx scripts/verify-reuse.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/env": "16.3.5",
    "@next/mdx": "16.3.5",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "js-yaml": "5.4.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@playwright/test": "1.63.0",
    "@types/js-yaml": "4.0.9",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chokidar": "5.0.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "sharp": "0.35.5",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
